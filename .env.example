# Copy to .env for local overrides. Never commit real credentials.
# Local compose database (development only; not a production secret).
POSTGRES_USER=geodiff
POSTGRES_PASSWORD=geodiff-local-dev
POSTGRES_DB=geodiff
POSTGRES_PORT=5433

# API
# Example only. In production set this through the host's secret store.
DATABASE_URL=postgresql://geodiff:geodiff-local-dev@localhost:5433/geodiff
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
DB_POOL_MAX=4
LOG_LEVEL=info

# Web (build-time, public values only)
VITE_API_URL=http://localhost:8000
